{
  "name": "dsh-plugin-modern-web-guidance",
  "version": "0.1.1",
  "description": "DeepSeek Harness plugin: exposes Google Chrome's Modern Web Guidance (search / retrieve / list of curated modern web platform guides) as agent tools.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.19"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "web",
    "chrome",
    "best-practices",
    "css",
    "html"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node test/smoke.mjs"
  },
  "dependencies": {
    "modern-web-guidance": "^1.0.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-tools": "*"
  }
}
